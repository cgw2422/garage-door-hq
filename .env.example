# --- Which deployment is this? --------------------------------------------
#
# The most important variable in this file. It decides whether outbound email
# reaches real people, whether a live Stripe key is accepted, whether the demo
# installer will run, and whether the UI wears a STAGING badge.
#
#   development   a laptop
#   staging       a deployment holding test data
#   production    the one with real garage door companies on it
#
# It FAILS CLOSED: unset on a deployment means staging, never production,
# because a production deployment that forgets it holds email back for an hour
# while a staging one mistaken for production emails real homeowners for ever.
# /api/health reports which it is and whether it was declared or inferred.
APP_ENV="development"

# --- Database -------------------------------------------------------------
# Railway provisions this automatically when you add a PostgreSQL plugin.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/garage_door_hq?schema=public"

# --- Auth -----------------------------------------------------------------
# REQUIRED, and the app cannot sign anyone in without it. Generate with:
#   openssl rand -base64 32
# An empty value fails exactly like a missing one. The name is AUTH_SECRET,
# not NEXTAUTH_SECRET — the old v4 name is ignored silently, which looks
# identical to setting nothing at all.
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# AUTH_URL is for local development ONLY, and only when you are not on :3000.
#
# DO NOT SET IT ON A DEPLOYMENT. Auth.js treats it as authoritative: if it says
# localhost, signing in on your real domain redirects the browser to
# localhost:3000 and the page fails to load. The app sets trustHost, so on
# Railway, Fly or Vercel the correct origin is read from the request.
# AUTH_URL="http://localhost:3000"

# --- Application ----------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Garage Door HQ"

# The address customers reach you at, e.g. https://app.garagedoorhq.com.
#
# Every link that leaves the building is built from this: estimate and invoice
# links, team invitations, password resets, the page Stripe returns to. Leaving
# it at localhost on a deployment does not crash anything — it emails your
# customers a link to their own machine. The app refuses to send rather than do
# that, so set it to the real address.
#
# NEXT_PUBLIC_* values are inlined when the app is BUILT, server code included,
# so changing this on a running deployment does nothing until the next build.
# Set APP_URL instead when you need it read at run time; it wins over this one.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# APP_URL=""

# Running a production build on your own machine, where localhost really is the
# address. Never set this on a deployment: it is the check that stops customers
# being emailed a link to their own computer.
# ALLOW_LOCAL_APP_URL="true"

# Length of the free trial granted at signup, in days.
TRIAL_DAYS="14"

# The demo seed's password and platform-admin address. Set these on anything
# deployed, so the seeded accounts do not use a password that is in the repo.
# On production DEMO_PASSWORD is required and the repository's default is
# refused outright — seeding fails rather than putting a published password on
# a real sign-in page.
# DEMO_PASSWORD=""
# PLATFORM_ADMIN_EMAIL="admin@yourdomain.com"

# `npm run db:seed` wipes every table. It refuses to do that when NODE_ENV is
# production unless this is set, which it should never be on a real deployment.
# ALLOW_SEED_RESET="true"

# To load the demo company on a deployment WITHOUT wiping anything, set a long
# random token here, POST it to /api/admin/seed-demo, then unset it. Add
# ?replace=1 to delete the demo company and load it fresh — that affects the
# demo tenant and nothing else. While this is unset or shorter than 24
# characters the route answers 404 to everything.
# DEMO_SEED_TOKEN="

# Keeping the demo company ON production, deliberately — a walkthrough you can
# give a prospect on the real address. Installing or rebuilding it there needs
# this as well as the token above, because the rebuild deletes a tenant.
#
# Do not reach for APP_ENV instead. Clearing that unlocks outbound email, the
# Stripe mode check and the storage namespace in the same motion. This unlocks
# one thing: the organization whose slug is the demo company's, plus the two
# accounts it owns. It never touches PLATFORM_ADMIN_EMAIL's account, and it
# never removes a person or partner that a real company still uses.
#
# Remove it afterwards. /admin/system reports it as a fault on production
# while it is set, so a forgotten one is visible rather than silent.
# ALLOW_DEMO_RESET="1"

# --- SMS (not wired up yet) ------------------------------------------------
# SMS_PROVIDER_API_KEY=""

# --- Storage --------------------------------------------------------------
# Cloudflare R2. The bucket must be PRIVATE: no public access, no r2.dev domain.
# Reads are brokered by the app at /api/files/photos/[id] after an auth check.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="garage-door-hq"
# R2_ENDPOINT=""                      # optional; derived from the account id

# Force the development disk driver even when R2 credentials are present.
# STORAGE_DRIVER="local"
# LOCAL_STORAGE_DIR=".storage"

# --- Transactional email ---------------------------------------------------
# One provider is enough. Resend is tried first when both are present;
# EMAIL_PROVIDER forces a choice ("resend", "postmark", "console").
# Without either, the app logs messages instead of sending and says so in the
# UI — it never claims a message was delivered.
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# POSTMARK_SERVER_TOKEN=""
# Only needed to point a provider at a different host (a sandbox, a proxy).
# RESEND_BASE_URL=""
# POSTMARK_BASE_URL=""
# POSTMARK_MESSAGE_STREAM="outbound"

# The envelope sender. Must be a domain you have verified (SPF/DKIM) with the
# provider. Customer-facing mail shows the garage door company's name against
# this address, so replies go to the company's own inbox instead.
EMAIL_FROM_ADDRESS="no-reply@garagedoorhq.test"
EMAIL_FROM_NAME="Garage Door HQ"
# EMAIL_SUPPORT_ADDRESS="support@garagedoorhq.com"

# --- Stripe: Garage Door HQ's own $39.99/month subscription ----------------
# Without STRIPE_SECRET_KEY the product runs, trials work, and every billing
# screen says billing is not connected. Nothing pretends to charge anyone.
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# The recurring price for the one plan.
# STRIPE_PRICE_ID_STANDARD=""
# Signing secret for the platform webhook endpoint (/api/webhooks/stripe).
# STRIPE_WEBHOOK_SECRET=""
# Signing secret for the Connect endpoint, if you register it separately.
# Falls back to STRIPE_WEBHOOK_SECRET when unset.
# STRIPE_CONNECT_WEBHOOK_SECRET=""

# --- Keeping staging away from real people --------------------------------
#
# Outside production every outbound email passes a gate. With NEITHER of these
# set, staging sends nothing at all — which is the safe default and usually
# what you want. Whatever does get through is subject-tagged
# [GARAGE DOOR HQ STAGING].
#
# Send everything to one inbox, with the intended recipient named in the
# subject and a banner in the body:
# STAGING_EMAIL_REDIRECT_TO="you@yourdomain.com"
#
# Or allow only these addresses; "@domain.com" allows a whole domain:
# STAGING_EMAIL_ALLOWLIST="you@yourdomain.com,@yourdomain.com"
#
# Neither has any effect on production, where mail always sends.

# --- Backups, as far as the System Readiness screen can tell ---------------
#
# Railway's scheduled backups are a platform setting with no API this
# application can read, so it will not claim they exist. Record what you
# actually configured, and when you last proved a restore works. The screen
# turns green only when both are set, and asks for another restore after ~4
# months, because a backup nobody has restored is a hypothesis.
# BACKUP_SCHEDULE="Daily at 03:00 UTC, 30 days retention, Railway + weekly dump to R2"
# BACKUP_LAST_VERIFIED_RESTORE="2026-09-17"
