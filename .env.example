# --- Database -------------------------------------------------------------
# Railway provisions this automatically when you add a PostgreSQL plugin.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/garage_door_hq?schema=public"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public origin of the deployment, e.g. https://app.garagedoorhq.com
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Application ----------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Garage Door HQ"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Length of the free trial granted at signup, in days.
TRIAL_DAYS="14"

# --- Billing (Phase 4 - not wired up yet) ---------------------------------
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_ID_STANDARD=""

# --- Messaging (Phase 4 - not wired up yet) -------------------------------
# SMS_PROVIDER_API_KEY=""
# EMAIL_PROVIDER_API_KEY=""

# --- Storage --------------------------------------------------------------
# Cloudflare R2. The bucket must be PRIVATE: no public access, no r2.dev domain.
# Reads are brokered by the app at /api/files/photos/[id] after an auth check.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="garage-door-hq"
# R2_ENDPOINT=""                      # optional; derived from the account id

# Force the development disk driver even when R2 credentials are present.
# STORAGE_DRIVER="local"
# LOCAL_STORAGE_DIR=".storage"
